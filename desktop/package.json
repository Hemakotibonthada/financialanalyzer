{
  "name": "financial-analyzer-desktop",
  "productName": "Financial Analyzer",
  "version": "1.0.0",
  "description": "Desktop application for Financial Analyzer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "financial",
    "analyzer",
    "desktop",
    "electron"
  ],
  "author": "Financial Analyzer Team",
  "license": "MIT",
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^39.2.2",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.financialanalyzer.app",
    "productName": "Financial Analyzer",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "landing.html",
      "package.json",
      "../frontend/dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Financial Analyzer",
      "runAfterFinish": true,
      "artifactName": "FinancialAnalyzerSetup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "FinancialAnalyzer-Portable-${version}.${ext}"
    }
  }
}
