# ==========================================
# Financial Analyzer - Backend Configuration
# ==========================================
# Copy this file to .env and fill in your actual values

# ==========================================
# Server Configuration
# ==========================================
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ==========================================
# MongoDB Database
# ==========================================
MONGODB_URI=mongodb://localhost:27017/financial_analyzer
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/financial_analyzer?retryWrites=true&w=majority

# ==========================================
# JWT Authentication
# ==========================================
# IMPORTANT: Generate a secure random string for production!
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secure_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# Gmail / Google OAuth Integration
# ==========================================
# Get credentials from: https://console.cloud.google.com
# 1. Create a project
# 2. Enable Gmail API + Google Drive API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URIs below
#
# The app reads GMAIL_CLIENT_ID first, falls back to GOOGLE_CLIENT_ID.
# Set both to the same value for full compatibility.
GMAIL_CLIENT_ID=your_gmail_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:5001/api/auth/gmail/callback

# Aliases (same values — used by some modules)
GOOGLE_CLIENT_ID=your_gmail_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_gmail_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5001/api/auth/gmail/callback

# ==========================================
# Google Drive Backup/Sync
# ==========================================
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5001/api/drive/callback

# ==========================================
# Google Cloud Platform (GCP) Storage
# ==========================================
# Used for cloud backup of accounts, transactions, and financial data
# 1. Create a GCP project at https://console.cloud.google.com
# 2. Enable the Cloud Storage API
# 3. Create a Storage bucket
# 4. Create a service account with Storage Admin role
# 5. Download the JSON key file

GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=your-financial-analyzer-bucket
GCP_STORAGE_LOCATION=ASIA-SOUTH1

# Option A: Path to service account key file
GCP_KEY_FILE=./config/gcp-service-account.json

# Option B: Inline JSON credentials (for cloud deployments / CI/CD)
# GCP_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ==========================================
# Exchange Rate API (optional, for live currency rates)
# ==========================================
# Get free key from: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# ==========================================
# AI Service Configuration
# ==========================================
# Choose your AI provider: 'ollama' (local) or 'openai' (cloud)
AI_PROVIDER=ollama

# Ollama Configuration (Local AI - FREE)
# Install from: https://ollama.ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
# Alternative models: llama2, codellama, llama2:13b, mistral:7b-instruct

# OpenAI Configuration (Cloud AI)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
# Alternative models: gpt-3.5-turbo, gpt-4-turbo, gpt-4

# ==========================================
# Email Services (Optional)
# ==========================================
# For sending notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_specific_password
EMAIL_FROM=Financial Analyzer <noreply@financialanalyzer.com>

# For Gmail: Generate app password at https://myaccount.google.com/apppasswords

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=50
# Maximum file size in MB (default: 50MB)

MAX_FILES=10
# Maximum number of files per upload

UPLOAD_DIR=./uploads
# Directory for storing uploaded documents

# ==========================================
# PDF Processing
# ==========================================
# Path to qpdf binary for password-protected PDFs
# If not set, the app auto-detects qpdf from system PATH.
#
# Install:
#   Mac:     brew install qpdf
#   Linux:   sudo apt install qpdf
#   Windows: winget install qpdf.qpdf
#
# Manual path (only needed if auto-detect fails):
#   Windows: QPDF_PATH=C:\Program Files\qpdf 12.3.2\bin\qpdf.exe
#   Mac:     QPDF_PATH=/opt/homebrew/bin/qpdf
#   Linux:   QPDF_PATH=/usr/bin/qpdf
# QPDF_PATH=

# ==========================================
# Security Configuration
# ==========================================
# Session secret for cookie signing
SESSION_SECRET=your_session_secret_key_change_this

# Bcrypt password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# Enable/disable CORS
ENABLE_CORS=true

# ==========================================
# WebSocket Configuration
# ==========================================
WEBSOCKET_ENABLED=true
WEBSOCKET_PATH=/socket.io
WEBSOCKET_CORS_ORIGIN=http://localhost:3000

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
# Time window in milliseconds (default: 15 minutes)

RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per IP per window

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info
# Options: error, warn, info, http, verbose, debug, silly

LOG_FILE_PATH=./logs
# Directory for log files

VERBOSE_LOGGING=false
# Enable detailed logging for debugging

# ==========================================
# Currency Exchange API (Optional)
# ==========================================
# For multi-currency support
# Get free API key from: https://exchangeratesapi.io/
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_BASE_CURRENCY=INR

# ==========================================
# Analytics & Monitoring (Optional)
# ==========================================
# Google Analytics
GA_TRACKING_ID=

# Sentry Error Tracking
# Get DSN from: https://sentry.io
SENTRY_DSN=

# ==========================================
# Plaid Banking Integration (Optional)
# ==========================================
# Get credentials from: https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ==========================================
# Twilio SMS Notifications (Optional)
# ==========================================
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==========================================
# Feature Flags
# ==========================================
ENABLE_GMAIL_SYNC=true\nGMAIL_AUTO_SYNC_INTERVAL_MS=900000\n# Gmail auto-sync interval: 900000 = 15 min, 1800000 = 30 min
ENABLE_AI_PROCESSING=true
ENABLE_WEBSOCKETS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_ANALYTICS=false

# ==========================================
# Development & Testing
# ==========================================
DEBUG=false
# Enable debug mode for detailed error messages

TEST_MODE=false
# Skip external API calls in test mode

MOCK_AI_RESPONSES=false
# Use mock AI responses instead of real API calls

# ==========================================
# Production Settings (DO NOT CHANGE IN DEV)
# ==========================================
TRUST_PROXY=false
# Set to true when behind a reverse proxy (nginx, etc.)

SECURE_COOKIES=false
# Set to true when using HTTPS

HELMET_ENABLED=false
# Enable security headers (recommended for production)

# ==========================================
# Bank Statement Processing
# ==========================================
# Supported formats: ICICI, HDFC, SBI, AXIS, KOTAK
# Add custom patterns for your bank if needed
BANK_STATEMENT_FORMATS=ICICI,HDFC,SBI,AXIS

# Password generation for ICICI (FirstName + DDMM format)
AUTO_GENERATE_PASSWORDS=true

# ============================================
# Cloudflare R2 object storage (S3-compatible)
# ============================================
# Backups, reports and financial documents. R2 is preferred over GCS because
# this workload is read-on-demand and R2 does not charge for egress.
#
# Both backends expose an identical interface; services/storageProvider.js picks
# one at startup. Leave STORAGE_PROVIDER unset to auto-select (R2 first, then
# GCP), or pin it explicitly.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=financialanalyzer-documents
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_REGION=auto

# ============================================
# Neon Postgres (optional but recommended)
# ============================================
# MongoDB stays the primary store. Postgres carries the append-heavy,
# relational pieces: auth sessions, the security audit trail, per-day analytics
# rollups and the cloud-storage object index.
#
# Without DATABASE_URL the app runs on MongoDB alone and these are skipped.
# Apply the schema with:  npm run db:migrate
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
PGPOOL_MAX=5
