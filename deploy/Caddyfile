# Caddy reverse proxy — automatic HTTPS via Let's Encrypt.
# DOMAIN and ACME_EMAIL are injected from the environment (see docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API + WebSocket (socket.io) go to the Node backend
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy api:5001
	}

	# Everything else is the static SPA (nginx)
	handle {
		reverse_proxy web:80
	}

	# Sensible security headers for the whole site
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
