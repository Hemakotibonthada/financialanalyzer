# ===== Cloud Functions environment =====
# Copy to functions/.env and fill in before deploying.
# Firebase CLI (v11+) loads functions/.env into process.env at deploy time.
#
# Note: `firebase functions:config:set` does NOT populate process.env — it
# populates functions.config(). This code reads process.env, so use this file.

# ---- Required ----

# Signing key for the JWTs this API issues. Must match nothing else in the
# stack and must be kept secret. Generate with: openssl rand -hex 32
# The API refuses to issue or accept tokens when this is unset.
JWT_SECRET=

# Firebase Web API key, used to verify email/password logins through the
# Identity Toolkit REST API. The Admin SDK cannot check passwords, so without
# this the login endpoint fails closed with HTTP 503.
# Find it at: Firebase Console > Project settings > General > Web API Key
# (This is the same public value used by the frontend web SDK config.)
FIREBASE_API_KEY=

# ---- Optional ----
NODE_ENV=production
