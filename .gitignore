# Node.js dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
backend/dist/
backend/logs/
desktop/dist/

# Environment and credentials
*.env
backend/.env
frontend/.env
# Vercel CLI link + pulled env. .vercel/.env.production.local holds real values.
# Relying on frontend/.gitignore alone is fragile - it was itself untracked.
.vercel
**/.vercel
# Timestamped .env backups written by scripts/setup-cloud-db.js — these contain
# live database credentials and must never be committed.
.env.backup-*
**/.env.backup-*
# Production secrets (generated on the server by deploy.sh — never commit)
.env.prod
deploy/.env.prod
# Per-environment secrets generated by deploy/deploy.sh. Each holds JWT,
# encryption, session and MongoDB root credentials for that environment.
.env.fin
.env.dev
.env.edge
.env.staging
.env.production
Helper/credentials.json
Helper/token.json

# Uploads and generated content
uploads/
backend/uploads/
frontend/uploads/
**/mails/
**/mails/*

# User data backups written by services/backupService.js. These are gzipped
# dumps of real accounts, transactions and financial profiles — committing one
# would publish a user's finances.
backend/backups/
backups/

# Local MongoDB data directory created by scripts/start-local-db.js. Database
# files, not source.
backend/data/local-mongo/
**/data/local-mongo/

# Debugging artifacts
*.log
!**/logs/.gitkeep
backend/server-crash.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor/scratch copies — these drift from the real file and get edited by
# mistake.
*.bak
*.orig
*.rej

# Python bytecode
__pycache__/
*.py[cod]

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Python virtual environments
venv/
.env/

# Speech recognition temp files
last_email_id.txt

# Executable files
*.exe
*.dll
*.so
*.dylib

script-output.txt
*.transform.js
add-theme-to-pages.js

