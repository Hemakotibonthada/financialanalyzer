    { icon: TrendingUp, title: 'Budget Tracking', desc: 'Smart budget allocation, monitoring, and spending limits', category: 'Core', image: 'https://images.unsplash.com/photo-1554224311-beee460c201f?w=400&h=300&fit=crop' },
