# ==========================================
# Financial Analyzer - Frontend Configuration
# ==========================================
# Copy this file to .env and fill in your values

# ==========================================
# Backend API Configuration
# ==========================================
VITE_API_URL=http://localhost:5001/api
# Backend API base URL

VITE_WS_URL=http://localhost:5001
# WebSocket server URL (for real-time updates)

# ==========================================
# Google OAuth (for Gmail Integration)
# ==========================================
# Must match the OAuth client from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your_gmail_oauth_client_id.apps.googleusercontent.com

# ==========================================
# Application Settings
# ==========================================
VITE_APP_NAME=Financial Analyzer
VITE_APP_VERSION=1.0.0

# ==========================================
# Feature Flags
# ==========================================
VITE_ENABLE_GMAIL_SYNC=true
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_WEBSOCKETS=true
VITE_ENABLE_ANALYTICS=false

# ==========================================
# UI Configuration
# ==========================================
VITE_CURRENCY_SYMBOL=₹
VITE_DEFAULT_LOCALE=en-IN
VITE_DATE_FORMAT=DD/MM/YYYY

# ==========================================
# Analytics (Optional)
# ==========================================
VITE_GA_TRACKING_ID=
# Google Analytics tracking ID

VITE_MIXPANEL_TOKEN=
# Mixpanel analytics token

# ==========================================
# Development Settings
# ==========================================
VITE_DEBUG_MODE=false
# Show debug information in console

VITE_MOCK_API=false
# Use mock API responses for testing

# ==========================================
# File Upload Settings
# ==========================================
VITE_MAX_FILE_SIZE=52428800
# Maximum file size in bytes (default: 50MB)

VITE_ACCEPTED_FILE_TYPES=.pdf,.doc,.docx,.jpg,.jpeg,.png
# Comma-separated list of accepted file extensions
