# ===== FinancialAnalyzer production environment =====
# Copy to .env.prod and fill in. deploy.sh generates strong secrets automatically
# if .env.prod does not exist, so you normally only edit the OPTIONAL block.

# ---- Required (auto-generated by deploy.sh if missing) ----
DOMAIN=finserve.circuvent.com
ACME_EMAIL=you@example.com
APP_NAME=Financial Analyzer

# 32-byte hex secrets — generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=
MONGO_ROOT_PASSWORD=

# ---- Optional integrations (leave blank to disable; features degrade gracefully) ----
# SMTP for real verification / notification emails (else emails are logged only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Razorpay live keys enable real paid subscriptions (else billing runs in dev mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry error tracking
SENTRY_DSN=
