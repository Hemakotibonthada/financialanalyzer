# ===== FinancialAnalyzer per-environment configuration =====
#
# deploy/deploy.sh generates one of these per environment and fills the secrets
# automatically, so you normally only edit the OPTIONAL block:
#
#   .env.fin    production   https://fin.circuvent.com   (main branch)
#   .env.dev    staging      https://dev.circuvent.com   (dev branch)
#   .env.edge   shared Caddy edge proxy (ACME_EMAIL + both domains)
#
# Secrets are deliberately DIFFERENT per environment: a leaked staging key must
# not grant anything in production. All three files are gitignored.

# ---- Identity (set by deploy.sh from the environment argument) ----
ENV_NAME=fin
DOMAIN=fin.circuvent.com
APP_NAME=Financial Analyzer

# ---- Required (auto-generated by deploy.sh if missing) ----
# 32-byte hex secrets - generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
SESSION_SECRET=
MONGO_ROOT_PASSWORD=

# ---- Optional integrations (leave blank to disable; features degrade gracefully) ----
# SMTP for real verification / notification emails (else emails are logged only)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Razorpay live keys enable real paid subscriptions (else billing runs in dev mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry error tracking
SENTRY_DSN=

# ===== .env.edge (shared proxy) looks like this instead =====
# ACME_EMAIL=you@example.com
# PROD_DOMAIN=fin.circuvent.com
# DEV_DOMAIN=dev.circuvent.com